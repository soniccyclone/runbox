node_modules/

# Built site and the org generated from shipped markdown. Both are outputs.
site/www/
site/gen/
site/org/skill-*.org
site/org/run-contract.org

# Staged deliverable, if anyone still runs a package step by hand.
dist/

# Run output and verdicts, in case runbox is ever pointed at this repo.
.harness-out/
.harness-verdicts.json
harness/

# Exports are generated artefacts.
*.runbox.html

# .NET build leftovers. NOT a bare `bin/`: that is the deposit CLI's home, and
# ignoring it silently drops bin/runbox.js from the package.
**/bin/Debug/
**/bin/Release/
obj/
